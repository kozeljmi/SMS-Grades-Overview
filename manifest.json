{
  "manifest_version": 3,
  "name": "SMS Grades & BAC Calculator",
  "version": "1.8.8",
  "description": "Grades overview widget and European Baccalaureate calculator for sms.eursc.eu dashboard (beta)",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://sms.eursc.eu/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "web_accessible_resources": [{
    "resources": ["scares/*"],
    "matches": ["https://sms.eursc.eu/*"]
  }],
  "content_scripts": [
    {
      "matches": ["https://sms.eursc.eu/content/common/dashboard.php*"],
      "js": ["content.js", "bac.js"],
      "css": ["content.css", "bac.css"],
      "run_at": "document_idle"
    }
  ]
}
